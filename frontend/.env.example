# Copy to .env.local and adjust if you run the API on a different port.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Optional. Leave unset to derive the WebSocket URL from NEXT_PUBLIC_API_BASE.
# Set it only when the socket lives elsewhere (different host, TLS terminator).
# NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# Optional. The firm name shown in the sidebar, page title and sign-in page.
# NEXT_PUBLIC_FIRM_NAME=Aura

NEXT_TELEMETRY_DISABLED=1
