# Yuki OS Portal — local-only configuration.
# Nothing in this file may point at a remote service.

# --- Database: PostgreSQL 16 + pgvector (RUNNING.md, "Database") ---
# Local container on 127.0.0.1:5433, started with ./scripts/db.ps1 up.
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and stalls.
# These passwords are local development defaults only; scripts/db.ps1 and
# infra/postgres/compose.yaml read them from this file.
AURA_PG_SUPERUSER_PASSWORD=aura_super_dev
AURA_PG_OWNER_PASSWORD=aura_owner_dev
AURA_PG_APP_PASSWORD=aura_app_dev
# What the API and worker connect as (aura_app: DML only, bound by row-level security).
# This is also the default when the key is missing.
AURA_DATABASE_URL=postgresql+psycopg://aura_app:aura_app_dev@127.0.0.1:5433/aura
# Alembic runs as the schema owner. When set, the API runs `alembic upgrade head` on start;
# when unset, it only checks the schema is at head and refuses to start if it is not.
AURA_MIGRATION_DATABASE_URL=postgresql+psycopg://aura_owner:aura_owner_dev@127.0.0.1:5433/aura

AURA_JWT_SECRET=dev-secret-change-me
AURA_JWT_TTL_MINUTES=480

# Local inference only. No cloud LLM, no API keys, ever.
AURA_OLLAMA_BASE_URL=http://127.0.0.1:11434
AURA_OLLAMA_MODEL=qwen3.5:4b

# Gate policy: any action worth more than this (INR) always needs a human. Default 5 crore.
AURA_MATERIALITY_CAP_INR=50000000

# Outbound email (RUNNING.md, "Gmail (outbound email)"). off | gmail_draft | gmail_send.
# Connect first: uv run python -m aura.mcp.gmail_auth  (client file: backend/client_secret.json)
AURA_OUTBOUND_MODE=off
AURA_OUTBOUND_DAILY_LIMIT=50

# --- Telemetry kill switches ---
# CrewAI ships anonymous usage telemetry ON by default; these disable it
# and the OpenTelemetry exporter it rides on.
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true

# Belt and braces: if any library tries to reach OpenAI, fail loudly
# rather than silently succeeding against a stray key in the environment.
OPENAI_API_KEY=
